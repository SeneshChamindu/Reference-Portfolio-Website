{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Extracted from the Reference Portfolio Website. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f1f5ec", "$description": "Derived light surface; the source ships a dark-first presentation." },
      "foreground": { "$value": "#14221d" },
      "border": { "$value": "#c9d6c8" },
      "card": { "$value": "#fbfdf8" },
      "cardForeground": { "$value": "#14221d" },
      "popover": { "$value": "#fbfdf8" },
      "popoverForeground": { "$value": "#14221d" },
      "primary": {
        "$value": "#5c8f16",
        "$description": "Neon-lime brand emphasis mapped to a readable light-mode equivalent."
      },
      "primaryForeground": { "$value": "#f8fff0" },
      "secondary": { "$value": "#dce9d9" },
      "secondaryForeground": { "$value": "#183027" },
      "muted": { "$value": "#e4eee2" },
      "mutedForeground": { "$value": "#557064" },
      "accent": { "$value": "#238d8a" },
      "accentForeground": { "$value": "#f4fffb" },
      "destructive": { "$value": "#c7463f" },
      "destructiveForeground": { "$value": "#fff7f5" },
      "input": { "$value": "#c9d6c8" },
      "ring": { "$value": "#5c8f16" },
      "chart1": { "$value": "#5c8f16" },
      "chart2": { "$value": "#238d8a" },
      "chart3": { "$value": "#8da83e" },
      "chart4": { "$value": "#315f4c" },
      "chart5": { "$value": "#b86b2d" },
      "sidebar": { "$value": "#e8f0e5" },
      "sidebarForeground": { "$value": "#183027" },
      "sidebarBorder": { "$value": "#c9d6c8" },
      "sidebarPrimary": { "$value": "#5c8f16" },
      "sidebarPrimaryForeground": { "$value": "#f8fff0" },
      "sidebarAccent": { "$value": "#dce9d9" },
      "sidebarAccentForeground": { "$value": "#183027" },
      "sidebarRing": { "$value": "#5c8f16" }
    },
    "dark": {
      "background": { "$value": "#09110f" },
      "foreground": { "$value": "#eff4e5" },
      "border": { "$value": "#28342f" },
      "card": { "$value": "#101815" },
      "cardForeground": { "$value": "#eff4e5" },
      "popover": { "$value": "#101815" },
      "popoverForeground": { "$value": "#eff4e5" },
      "primary": {
        "$value": "#c3ff47",
        "$description": "Neon lime used for the signature wordmark, primary actions, status dots, focus, and motion accents."
      },
      "primaryForeground": { "$value": "#09110f" },
      "secondary": { "$value": "#16352b" },
      "secondaryForeground": { "$value": "#d9ffc0" },
      "muted": { "$value": "#152421" },
      "mutedForeground": { "$value": "#93a299" },
      "accent": { "$value": "#70d8d2" },
      "accentForeground": { "$value": "#07100f" },
      "destructive": { "$value": "#ff716b" },
      "destructiveForeground": { "$value": "#180b0a" },
      "input": { "$value": "#28342f" },
      "ring": { "$value": "#c3ff47" },
      "chart1": { "$value": "#c3ff47" },
      "chart2": { "$value": "#70d8d2" },
      "chart3": { "$value": "#8eaf4b" },
      "chart4": { "$value": "#315f4c" },
      "chart5": { "$value": "#d08b4e" },
      "sidebar": { "$value": "#0d1b18" },
      "sidebarForeground": { "$value": "#eff4e5" },
      "sidebarBorder": { "$value": "#28342f" },
      "sidebarPrimary": { "$value": "#c3ff47" },
      "sidebarPrimaryForeground": { "$value": "#09110f" },
      "sidebarAccent": { "$value": "#16352b" },
      "sidebarAccentForeground": { "$value": "#d9ffc0" },
      "sidebarRing": { "$value": "#c3ff47" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Rounded geometric sans used for display type, navigation, body copy, and interface controls."
      },
      "serif": { "$value": ["Georgia", "serif"], "$description": "Reserved fallback; the source uses no serif role." },
      "mono": { "$value": ["DM Mono", "monospace"], "$description": "Technical labels, metadata, coordinates, and eyebrow copy." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.65rem",
      "$description": "Compact radius used for cards, inputs, badges, and auth surfaces; hero media may use larger composition-specific corners."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base step; layouts commonly build 12px, 16px, 24px, 32px, 48px, and 80px intervals."
    }
  }
}
